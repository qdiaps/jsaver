#!/usr/bin/env bash
# Git commit-msg hook to validate Conventional Commits format

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits and initial/release tag patterns
if echo "$COMMIT_MSG" | grep -qE "^(Merge branch|Merge pull request|Revert)"; then
    exit 0
fi

# Conventional Commits regex pattern:
# type(scope?): description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "ERROR: Invalid commit message format."
    echo ""
    echo "Commit messages must follow Conventional Commits specification:"
    echo "  <type>(<optional scope>): <description>"
    echo ""
    echo "Allowed types:"
    echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo "Examples:"
    echo "  feat(bot): add yt-dlp command handler"
    echo "  fix(cli): handle process timeout gracefully"
    echo "  docs: update non-docker installation guide"
    echo ""
    echo "Your commit message was:"
    echo "  $COMMIT_MSG"
    exit 1
fi
