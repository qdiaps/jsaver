# =================================================================
# jsaver environment configuration
# Copy this file to .env and fill in the required credentials
# =================================================================


# ==============================================================================
# Telegram Bot & Local Bot API Server
# ==============================================================================

# Bot token obtained from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Telegram API credentials from https://my.telegram.org
# Required only when running a self-hosted Local Bot API Server
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Port for the local Telegram Bot API server (default: 8081)
TELEGRAM_BOT_API_PORT=8081

# Custom Telegram Bot API base URL (must end with /bot)
# Leave empty or comment out to use the official public Telegram API
TELEGRAM_BOT_API_URL=http://127.0.0.1:8081/bot

# Bot username without leading '@' and ending with 'bot' (e.g. jsaver_bot)
# Required for resolving /command@bot_username mentions in group chats
TELEGRAM_BOT_USERNAME=jsaver_bot


# ==============================================================================
# Security & Access Control
# ==============================================================================

# Comma-separated list of allowed Telegram user IDs (e.g. 123456789,987654321)
# Leave empty to allow all users (not recommended for public deployments)
ALLOWED_TELEGRAM_USERS=


# ==============================================================================
# Application & Runtime
# ==============================================================================

# Runtime environment profile: dev | prod (default: dev)
APP_ENV=dev

# Root logging level: TRACE | DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# Working directory for temporary downloads and media processing (default: ./data)
WORK_DIR=./data


# ==============================================================================
# Media Processing & CLI Tools
# ==============================================================================

# Maximum execution time in seconds for external CLI tools like yt-dlp/ffmpeg (default: 300)
COMMAND_TIMEOUT_SECONDS=300


# ==============================================================================
# Sender & Retry Policy
# ==============================================================================

# Maximum delivery attempts for important messages on 5xx/network errors (default: 3)
SENDER_RETRY_MAX_ATTEMPTS=3

# Base delay in milliseconds for exponential backoff between retries (default: 1000)
SENDER_RETRY_BASE_DELAY_MS=1000

# Fallback wait time in seconds for HTTP 429 if retry_after is missing (default: 3)
SENDER_FALLBACK_RETRY_AFTER_SEC=3

# Upper cap in seconds for HTTP 429 retry_after sleep duration (default: 60)
SENDER_MAX_RETRY_AFTER_SEC=60
