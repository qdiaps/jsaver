# =================================================================
# jsaver environment configuration
# Copy this file to .env and fill in the required credentials
# =================================================================

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Telegram API credentials (obtain from https://my.telegram.org)
# Required for running local Telegram Bot API Server
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Port for local Telegram Bot API server
TELEGRAM_BOT_API_PORT=8081

# Optional: custom Telegram Bot API URL.
# In Docker Compose, this is automatically set to http://telegram-bot-api:8081/bot
# For standalone local run or Android testing against public Telegram API, leave empty or comment out.
TELEGRAM_BOT_API_URL=

# Security: comma-separated list of allowed Telegram user IDs.
# Leave blank to allow all users (NOT recommended for public bots running CLI tools).
ALLOWED_TELEGRAM_USERS=12345678,87654321

# Application environment: 'dev' or 'prod'
APP_ENV=dev

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Default timeout in seconds for executing CLI commands
JSAVER_COMMAND_TIMEOUT_SECONDS=300

# Path to working directory for downloads and temp files
JSAVER_WORK_DIR=./data
