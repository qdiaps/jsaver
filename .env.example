# =================================================================
# jsaver environment configuration
# Copy this file to .env and fill in the required credentials
# =================================================================


# ==============================================================================
# Telegram Bot & Local Bot API Server
# ==============================================================================

# Bot token obtained from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Telegram API credentials from https://my.telegram.org
# Required only when running a self-hosted Local Bot API Server
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Port for the local Telegram Bot API server (default: 8081)
TELEGRAM_BOT_API_PORT=8081

# Custom Telegram Bot API base URL (must end with /bot)
# Leave empty or comment out to use the official public Telegram API
TELEGRAM_BOT_API_URL=http://127.0.0.1:8081/bot

# Bot username without leading '@' and ending with 'bot' (e.g. jsaver_bot)
# Required for resolving /command@bot_username mentions in group chats
TELEGRAM_BOT_USERNAME=jsaver_bot


# ==============================================================================
# Security & Access Control
# ==============================================================================

# Telegram user ID of the primary administrator (required, must be positive)
# Has full immunity and exclusive rights to manage other admins and global restrictions
TELEGRAM_ROOT_ADMIN_ID=

# Whitelist mode activates automatically on startup if at least one of the lists below
# is non-empty (only users, only chats, or both). Leave both empty to allow everyone.

# Comma-separated list of allowed user IDs for private chats (e.g. 123456789,987654321)
ALLOWED_TELEGRAM_USERS=

# Comma-separated list of allowed group/supergroup chat IDs (e.g. -1001234567890,-1009876543210)
# Note: Telegram group and supergroup IDs always start with a minus sign
ALLOWED_TELEGRAM_CHATS=


# ==============================================================================
# Application & Runtime
# ==============================================================================

# Runtime environment profile: dev | prod (default: dev)
APP_ENV=dev

# Root logging level: TRACE | DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# Working directory for temporary downloads and media processing (default: ./data)
WORK_DIR=./data

# Maximum time in seconds to wait for active tasks to finish during graceful shutdown (default: 30)
SHUTDOWN_TIMEOUT_SECONDS=30


# ==============================================================================
# Storage & Workspace
# ==============================================================================

# Subdirectory name inside WORK_DIR for isolated per-task temporary folders (default: tasks)
TASKS_DIR_NAME=tasks

# Disk space in MB reserved per active task (covers raw streams + final merged file up to 2 GB) (default: 4000)
TASK_DISK_RESERVE_MB=4000

# Minimum free disk space in MB kept untouched for OS, logs, and Local Bot API stability (default: 1536)
DISK_SAFETY_MARGIN_MB=1536


# ==============================================================================
# Media Processing & CLI Tools
# ==============================================================================

# Maximum execution time in seconds for heavy CLI downloads like yt-dlp/gallery-dl (default: 900)
COMMAND_TIMEOUT_SECONDS=900

# Maximum execution time in seconds for fast ffprobe/ffmpeg metadata and thumbnail commands (default: 30)
MEDIA_INSPECT_TIMEOUT_SECONDS=30

# Maximum stdout/stderr buffer size in KB retained per CLI process stream (default: 64)
CLI_OUTPUT_LIMIT_KB=64


# ==============================================================================
# Sender & Retry Policy
# ==============================================================================

# Maximum delivery attempts for important messages on 5xx/network errors (default: 3)
SENDER_RETRY_MAX_ATTEMPTS=3

# Base delay in milliseconds for exponential backoff between retries (default: 1000)
SENDER_RETRY_BASE_DELAY_MS=1000

# Fallback wait time in seconds for HTTP 429 if retry_after is missing (default: 3)
SENDER_FALLBACK_RETRY_AFTER_SEC=3

# Upper cap in seconds for HTTP 429 retry_after sleep duration (default: 60)
SENDER_MAX_RETRY_AFTER_SEC=60

# Cooldown in seconds before repeating identical throttled failure notifications in a chat (default: 15)
SENDER_THROTTLED_COOLDOWN_SEC=15
